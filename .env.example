# Lingkungan aplikasi
APP_ENV=production
APP_BASE_PATH=/app-tamu
APP_TIMEZONE=Asia/Jakarta

# Koneksi database (di dalam Docker, DB_HOST adalah nama service MySQL)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=guest_app
DB_USERNAME=guest_user
DB_PASSWORD=change_this_password

# Password root MySQL (hanya untuk container database)
MYSQL_ROOT_PASSWORD=change_root_password
